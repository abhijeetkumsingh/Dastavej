# Local development only. Production secrets must be set in the hosting dashboard.
DASTAVEJ_ENV=development
SECRET_KEY=6f1269d2f8934340e4abdcfac9e7502ea98a8bdfd2497e4c47a387b816a2717e

# Gemini (AI Document Assistant only)
GEMINI_API_KEY=AQ.Ab8RN6IoVl_F7pKVlV4x_2V0R3dxVk32mkbBI7apbu0r0j7psws
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=60

# Storage and limits
STORAGE_DIR=instance/storage
DATABASE_URL=sqlite:///instance/dastavej.db
FILE_TTL_MINUTES=60
CLEANUP_INTERVAL_SECONDS=300
MAX_UPLOAD_MB=50
MAX_FILES_PER_REQUEST=30
MAX_IMAGE_PIXELS=60000000
MAX_PDF_PAGES=300

# External tools
SOFFICE_BIN=
LIBREOFFICE_TIMEOUT=120
LIBREOFFICE_MEMORY_MB=4096
TESSDATA_PREFIX=tessdata
OCR_LANGS=eng+hin
OCR_MAX_PAGES=40

# Rate limiting
RATELIMIT_ENABLED=1
RATELIMIT_DEFAULT=300 per minute
RATELIMIT_HEAVY=40 per minute
RATELIMIT_STORAGE_URI=memory://

# Set to 1 when serving through HTTPS.
SESSION_COOKIE_SECURE=0
